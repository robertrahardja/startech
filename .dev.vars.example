# Environment Variables for Local Development
# Copy this file to .dev.vars and add your actual API keys

# OpenAI API Key — only /api/chat uses this now (disabled in production via
# ENABLE_AI_CHAT). The demo endpoint moved to Gemini, see GOOGLE_GEMINI_API_KEY
# below. Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ElevenLabs API Key (for TTS, optional)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Resend API Key (for contact form emails)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-key-here

# Google OAuth Client ID (for demo sign-in)
# Create one at: https://console.cloud.google.com/apis/credentials
# Application type: Web application. Authorized JavaScript origins must
# include http://localhost:5173 and https://startech-innovation.com.
#
# This is the WORKER's copy — it checks the ID token's `aud` claim against
# this value. The frontend needs the same value too, but as VITE_GOOGLE_
# CLIENT_ID, which Vite only picks up from a real environment variable at
# build time (this file isn't read by Vite), e.g.:
#   VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com npm run dev
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gemini API key (primary model for /api/demo — text and the invoice-scanner
# photo path both go through this). Free tier; get one at:
# https://aistudio.google.com/apikey
# This is a DIFFERENT credential from GOOGLE_CLIENT_ID above — that one is
# for verifying who signed in, this one is for calling the model.
# When Gemini's free-tier quota is hit, /api/demo automatically falls back to
# Cloudflare Workers AI (the [ai] binding in wrangler.toml) — no key needed
# for that, it's already local to this Worker.
GOOGLE_GEMINI_API_KEY=your-gemini-key-here
