# Scoped Cloudflare credentials for this project.
#
# Deploys here are gated on direnv being active (see ~/bin/direnv-deploy-gate):
# several Cloudflare accounts exist on this machine, and a single ambient
# `wrangler login` or global CLOUDFLARE_API_TOKEN could push this Worker into
# the wrong company's account. Keeping the token per-directory makes the
# target explicit.
#
# Secrets live in .envrc.local, which is gitignored. Copy the block below into
# it and fill in the values:
#
#   export CLOUDFLARE_API_TOKEN=...
#   export CLOUDFLARE_ACCOUNT_ID=...

source_env_if_exists .envrc.local

if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
  echo "direnv: .envrc.local missing CLOUDFLARE_API_TOKEN — deploys will fail" >&2
fi
