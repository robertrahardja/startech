# Copy to .envrc.local and fill in, then run: direnv allow
#
#   cp .envrc.local.example .envrc.local
#   $EDITOR .envrc.local
#   direnv allow
#
# .envrc.local is gitignored. This example is not — it carries no secrets.
#
# Both values come from the Cloudflare account that owns
# startech-innovation.com. Several accounts exist on this machine, so the
# token is what pins the deploy to the right one.
#
# Token:      My Profile -> API Tokens -> Create Custom Token
#             Account | Workers Scripts     | Edit
#             Account | Workers KV Storage  | Edit
#             Account | D1                  | Edit
#             Zone    | Workers Routes      | Edit
#             Scope it to this account and the startech-innovation.com zone.
#
# Account ID: right-hand sidebar of the account overview page.

export CLOUDFLARE_API_TOKEN=
export CLOUDFLARE_ACCOUNT_ID=
